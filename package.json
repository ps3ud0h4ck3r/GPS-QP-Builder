{
  "name": "gps-qp-builder",
  "private": true,
  "version": "3.0.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && esbuild worker/entry.js --bundle --format=esm --outfile=dist/_worker.js",
    "preview": "vite preview",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name gps-qp-builder"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "docx": "latest",
    "html2pdf.js": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "esbuild": "latest",
    "wrangler": "latest"
  }
}
